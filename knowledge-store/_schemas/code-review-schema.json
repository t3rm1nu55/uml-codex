{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Code Review Schema",
  "description": "Schema for storing code review insights with versioning support",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "description": "Schema version for tracking iterations"
    },
    "repository": {
      "type": "string",
      "description": "Repository identifier (org/repo-name)"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {"type": "string"},
          "changes": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "license": {
      "type": "string",
      "description": "Primary license of the repository"
    },
    "reuse_decision": {
      "type": "string",
      "enum": ["CAN_LIFT", "MUST_REBUILD", "HYBRID", "UNDER_REVIEW"]
    },
    "reuse_rationale": {
      "type": "string",
      "description": "Detailed explanation of reuse decision"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "description": {"type": "string"},
          "value_proposition": {"type": "string"},
          "dependencies": {"type": "array"},
          "license_compatible": {"type": "boolean"},
          "complexity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"]
          },
          "recommendation": {
            "type": "string",
            "enum": ["ADOPT", "ADAPT", "AVOID", "STUDY"]
          }
        }
      }
    },
    "design_patterns": {
      "type": "array",
      "description": "Architectural and design patterns identified"
    },
    "requirements_identified": {
      "type": "array",
      "description": "Requirements extracted from code analysis"
    },
    "technical_debt": {
      "type": "array",
      "description": "Technical debt and issues identified"
    },
    "notes": {
      "type": "string"
    }
  }
}
